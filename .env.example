# Server-side only. Never prefix this with NEXT_PUBLIC_ and never commit a real key.
# Create one at https://unsplash.com/developers -> New Application -> Access Key.
# The catalogue runs without it, using the local placeholder covers.
UNSPLASH_ACCESS_KEY=

# Used by .mcp.json to authenticate the Context7 MCP server (a Claude Code dev
# tool, not read by the site itself). Create a free key at
# https://context7.com/dashboard. Not required in Vercel.
CONTEXT7_API_KEY=
